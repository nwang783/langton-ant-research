(set-logic QF_LIA)
(set-option :timeout 10000)
(set-option :produce-models true)
(declare-fun z () Int)
(assert (>= z 1))
(declare-fun p0 () Int)
(assert (and (<= 0 p0) (< p0 z)))
(declare-fun q0 () Int)
(assert (and (<= 0 q0) (< q0 z)))
(declare-fun k0 () Int)
(assert (and (<= 0 k0) (< k0 z)))
(declare-fun l0 () Int)
(assert (and (<= 0 l0) (< l0 z)))
(assert (= (ite (= (mod p0 2) 0) 1 (- 1)) (ite (= (mod q0 2) 0) 1 (- 1))))
(assert (>= (- (ite (<= q0 p0) (ite (= (mod q0 2) 0) 1 (- 1)) 0) (ite (<= p0 p0) (ite (= (mod p0 2) 0) 1 (- 1)) 0)) 0))
(assert (>= (- (ite (<= q0 q0) (ite (= (mod q0 2) 0) 1 (- 1)) 0) (ite (<= p0 q0) (ite (= (mod p0 2) 0) 1 (- 1)) 0)) 0))
(assert (= (xor (= k0 p0) (not (= (mod k0 2) 0))) (= (mod q0 2) 0)))
(assert (ite (= (mod q0 2) 0) (= (+ (div k0 2) (ite (< p0 k0) (ite (= (mod p0 2) 0) 1 (- 1)) 0)) (+ (div q0 2) (ite (< q0 q0) (ite (= (mod q0 2) 0) 1 (- 1)) 0))) (= (- k0 (+ (div k0 2) (ite (< p0 k0) (ite (= (mod p0 2) 0) 1 (- 1)) 0))) (- q0 (+ (div q0 2) (ite (< q0 q0) (ite (= (mod q0 2) 0) 1 (- 1)) 0))))))
(assert (= (xor (= l0 q0) (not (= (mod l0 2) 0))) (= (mod p0 2) 0)))
(assert (ite (= (mod p0 2) 0) (= (+ (div p0 2) (ite (< p0 p0) (ite (= (mod p0 2) 0) 1 (- 1)) 0)) (+ (div l0 2) (ite (< q0 l0) (ite (= (mod q0 2) 0) 1 (- 1)) 0))) (= (- p0 (+ (div p0 2) (ite (< p0 p0) (ite (= (mod p0 2) 0) 1 (- 1)) 0))) (- l0 (+ (div l0 2) (ite (< q0 l0) (ite (= (mod q0 2) 0) 1 (- 1)) 0))))))
(assert (distinct k0))
(assert (=> (and true (> z 1)) (distinct l0 q0)))
(assert (=> (and true (> z 1)) (ite (> (- 2 (mod p0 2)) 0) (< l0 q0) (> l0 q0))))
(assert (=> (and (and true (> z 1)) (= (- 2 (mod p0 2)) 0) true) (= l0 (+ q0 1))))
(assert (=> (and true (> z 1)) (distinct p0 k0)))
(assert (=> (and true (> z 1)) (ite (> (- 2 (mod q0 2)) 0) (< p0 k0) (> p0 k0))))
(assert (=> (and (and true (> z 1)) (= (- 2 (mod q0 2)) 0) true) (= p0 (+ k0 1))))
